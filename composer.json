{
    "name": "pedropessutto/api-bancos",
    "description": "Biblioteca para integração com APIs bancárias",
    "keywords": [
        "pedropessutto",
        "api-bancos"
    ],
    "homepage": "https://github.com/pedropessutto/api-bancos",
    "authors": [
        {
            "name": "Pedro Pessutto",
            "email": "pedrospessutto@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/pedropessutto/laravel-boleto"
        }
    ],
    "require": {
        "php": "^8.1",
        "eduardokum/laravel-boleto": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "orchestra/testbench": "^8.37",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "PedroPessutto\\ApiBancos\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PedroPessutto\\ApiBancos\\Tests\\": "tests"
        }
    },
    "config": {
        "allow-plugins": true
    },
    "scripts": {
        "php-cs-fixer-check": "vendor/bin/php-cs-fixer fix --diff --verbose --dry-run",
        "php-cs-fixer": "vendor/bin/php-cs-fixer fix --verbose"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
